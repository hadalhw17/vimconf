" Use global clipboard
:set clipboard=unnamed

" Line numbers
:set nu
:set relativenumber

" Split
:set splitright
:set splitbelow

" Search
:set smartcase
:set incsearch
:set showmatch
:set ignorecase

" Line dragging with alt hjkl:
nnoremap <A-j> :m .+1<CR>==
nnoremap <A-k> :m .-2<CR>==
inoremap <A-j> <Esc>:m .+1<CR>==gi
inoremap <A-k> <Esc>:m .-2<CR>==gi
vnoremap <A-j> :m '>+1<CR>gv=gv
vnoremap <A-k> :m '<-2<CR>gv=gv
